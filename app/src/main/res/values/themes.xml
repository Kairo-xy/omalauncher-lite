        <item name="android:windowBackground">#FF101116</item>
        <item name="android:colorAccent">#FFB9A6FF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#FF101116</item>
        <item name="android:statusBarColor">#FF101116</item>
    </style>
</resources>
